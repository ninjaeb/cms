// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EDITOR
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EDITOR)
  createdAt    DateTime @default(now())
}

// One run of crawling `Setting.scanBaseUrl` (or an overridden URL) over
// HTTP and scoring each reachable page for SEO/GEO quality.
model ScanRun {
  id          String     @id @default(cuid())
  baseUrl     String
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?
  pageCount   Int        @default(0)
  avgSeoScore Int?
  avgGeoScore Int?
  pages       PageScan[]
}

// One crawled page's extracted signals, checklist, and scores from a ScanRun.
model PageScan {
  id        String  @id @default(cuid())
  scanRunId String
  scanRun   ScanRun @relation(fields: [scanRunId], references: [id], onDelete: Cascade)

  sourceUrl String
  urlPath   String
  title     String?

  seoScore Int
  geoScore Int

  // ChecklistItem[] as returned by computeChecklistFromPageSignals.
  checklist Json

  // Populated lazily when requested from the page detail view, not during
  // the scan itself, so scans stay fast and don't call the AI on every run.
  aiRecommendation String?

  scannedAt DateTime @default(now())

  @@index([scanRunId])
}

// Singleton site-wide configuration row.
model Setting {
  id                      Int     @id @default(1)
  scanBaseUrl             String  @default("")
  enableAiRecommendations Boolean @default(false)
}
