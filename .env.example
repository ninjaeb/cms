# Copy to .env and fill in real values. Never commit the real .env file
# (it's gitignored already).

# SQLite file used by Prisma. Point this at a persistent path outside the
# app's deployment directory in production (e.g. cPanel Node.js App's data
# dir) so redeploys don't wipe the database.
DATABASE_URL="file:./dev.db"

# Random secret used to sign admin session tokens. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""

# Public base URL of this CMS (used in sitemap.xml, canonical URLs,
# Open Graph tags, and llms.txt).
SITE_URL="http://localhost:3000"

# Seed script (npm run db:seed) admin credentials — change before seeding
# any real environment.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="changeme123"

# Optional shared secret for the public read-only content API
# (/api/public/content, /api/public/content/[slug]). Leave unset while
# developing; set it once an external site (e.g. gotka.com) is configured to
# send it as the `x-api-key` header, so the API isn't wide open to scraping.
PUBLIC_API_KEY=""
